{
  "name": "dsh-plugin-shelf",
  "version": "0.7.0",
  "description": "插件书架：优化 DSH 官方插件页的搜索、筛选、折叠、置顶、视图与安装信息。Plugin Shelf: visual organization for the native DSH plugins page.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/metadata.js",
    "locale/en.json",
    "locale/zh.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "dsh-plugin.naming.json"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-web",
    "plugins-page",
    "cards",
    "ui",
    "插件页",
    "卡片"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "liao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliblue-evan/dsh-plugin-shelf.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/metadata.js && node --check lib/client.js",
    "test": "node --test test/*.test.mjs",
    "pack:check": "node test/package-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.6-alpha.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "30.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "packageManager": "pnpm@11.7.0"
}
